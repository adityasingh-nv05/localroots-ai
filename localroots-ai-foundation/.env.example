# ============================================================================
# LocalRoots AI environment variables
# Copy to .env.local and fill in values from Supabase: Project Settings -> API.
# Never commit .env.local. Restart `npm run dev` after editing it.
# ============================================================================

# Your project URL, e.g. https://abcdefgh.supabase.co
# Public: safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Anon key (called "publishable key" on newer projects, starting sb_publishable_).
# Public: safe to ship to the browser. Row-level security limits what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Service-role key (called "secret key" on newer projects, starting sb_secret_).
# Used ONLY by scripts/admin-role.mjs, run from your own trusted machine.
# Bypasses row-level security. The web app never reads it, so leave it empty unless you run the admin script.
# Never prefix it with NEXT_PUBLIC_ and never paste it into client-side code.
SUPABASE_SERVICE_ROLE_KEY=
